# Leave blank for local development; Vite proxies /api to localhost:5000.
# For a separately hosted frontend, set this to the API service origin.
VITE_API_BASE_URL=

# Set true only after the matching OAuth application and backend credentials
# are configured and tested for the deployed environment.
VITE_OAUTH_GOOGLE_ENABLED=false
VITE_OAUTH_GITHUB_ENABLED=false
VITE_OAUTH_DISCORD_ENABLED=false

# Set true only after the provider, privacy approvals and backend AI feature flag are enabled.
VITE_CAMPUSFORGE_AI_ENABLED=false

# Project Pulse is provider-independent but separately feature-gated.
VITE_CAMPUSFORGE_PROJECT_PULSE_ENABLED=false
