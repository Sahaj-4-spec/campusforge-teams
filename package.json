{
  "name": "campusforge-teams",
  "version": "1.0.0",
  "private": true,
  "description": "A real-time project management and collaboration platform for student teams.",
  "scripts": {
    "dev": "concurrently -k -n client,server -c blue,green \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "npm --prefix client run dev",
    "dev:server": "cargo run --manifest-path server/Cargo.toml",
    "build": "npm --prefix client run build && cargo build --release --manifest-path server/Cargo.toml",
    "build:client": "npm --prefix client run build",
    "build:server": "cargo build --release --manifest-path server/Cargo.toml",
    "db:migrate": "cargo run --manifest-path server/Cargo.toml --bin migrate",
    "start": "cargo run --release --manifest-path server/Cargo.toml"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
