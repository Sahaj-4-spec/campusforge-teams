# API server
PORT=5000

# PostgreSQL connection (migrations are applied automatically at API startup)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Use a cryptographically random secret with at least 32 characters
JWT_SECRET=replace_this_with_a_long_random_secret_at_least_32_chars

# Frontend origin allowed to call the API and receive OAuth sign-in redirects
FRONTEND_ORIGIN=http://localhost:5173
# Optional OAuth return origin; defaults to the first FRONTEND_ORIGIN entry.
FRONTEND_REDIRECT_ORIGIN=

# Public API origin used to build provider callback URLs
OAUTH_REDIRECT_BASE_URL=http://localhost:5000

# Google OAuth web application credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth App credentials
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Discord application OAuth2 credentials
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=


# File storage: "local" for localhost; set "s3" for a private S3-compatible bucket in production.
CAMPUSFORGE_STORAGE_MODE=local
CAMPUSFORGE_UPLOAD_DIR=server/uploads
# In production, configure a private ClamAV TCP endpoint and enforce clean scans.
CAMPUSFORGE_CLAMAV_ADDR=
CAMPUSFORGE_REQUIRE_MALWARE_SCAN=false
CAMPUSFORGE_S3_BUCKET=
CAMPUSFORGE_S3_REGION=us-east-1
# Optional endpoint for S3-compatible services such as Cloudflare R2 or MinIO.
CAMPUSFORGE_S3_ENDPOINT_URL=
# SigV4 credentials must be injected as encrypted backend environment variables.
# AWS_SESSION_TOKEN is optional for temporary credentials.

# Optional email delivery. Email preferences stay disabled unless both values are configured.
RESEND_API_KEY=
EMAIL_FROM=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Track B AI assistant. Keep these variables on the Rust API server only.
# The feature remains off unless explicitly enabled and all values are valid.
CAMPUSFORGE_AI_ENABLED=false
CAMPUSFORGE_ENV=development
CAMPUSFORGE_AI_ALLOW_LOOPBACK_PROVIDER=false
# OpenAI-compatible API base URL; /chat/completions is appended by the server.
# Use HTTPS in hosted environments. Local HTTP requires both development flags and must not use a provider API key.
CAMPUSFORGE_AI_API_BASE_URL=
CAMPUSFORGE_AI_API_KEY=
CAMPUSFORGE_AI_MODEL=
